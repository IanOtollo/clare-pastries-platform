{
  "installCommand": "npm install -g pnpm && pnpm install",
  "buildCommand": "pnpm -w run build",
  "outputDirectory": "artifacts/clare-pastries/dist/public",
  "framework": null,
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
